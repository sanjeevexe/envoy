{
 "name": "skylark_check_in_flight",
 "intent": "Check in for a SkyLark flight",
 "description": "Opens My Trips in SkyLark Air, opens the requested trip, selects the passenger, acknowledges no hazardous materials, and confirms check-in to obtain the boarding pass.",
 "patterns": [
  "Check me in for my flight",
  "Check in for my trip",
  "Check me in",
  "Get my boarding pass"
 ],
 "inputs": [
  {
   "name": "trip_city",
   "type": "text",
   "description": "Destination city of the flight to check in for",
   "from_memory": null,
   "example": "Denver"
  }
 ],
 "steps": [
  {
   "step": 1,
   "id": "tap_my_trips",
   "intent": "Tap My Trips",
   "target_fixed_text": "My Trips",
   "choice_input": null
  },
  {
   "step": 2,
   "id": "tap_trip_row",
   "intent": "Tap the trip row for the flight to {{trip_city}}",
   "target_fixed_text": null,
   "choice_input": "trip_city"
  },
  {
   "step": 3,
   "id": "tap_check_in",
   "intent": "Tap Check in for the selected trip",
   "target_fixed_text": "Check in",
   "choice_input": null
  },
  {
   "step": 4,
   "id": "select_passenger",
   "intent": "Select the passenger to check in",
   "target_fixed_text": null,
   "choice_input": null
  },
  {
   "step": 5,
   "id": "tap_continue_passenger",
   "intent": "Tap Continue after selecting the passenger",
   "target_fixed_text": "Continue",
   "choice_input": null
  },
  {
   "step": 6,
   "id": "acknowledge_hazardous_materials",
   "intent": "Toggle the acknowledgement that I am not carrying hazardous materials",
   "target_fixed_text": "I'm not carrying hazardous materials",
   "choice_input": null
  },
  {
   "step": 7,
   "id": "tap_continue_hazmat",
   "intent": "Tap Continue after the hazardous materials acknowledgement",
   "target_fixed_text": "Continue",
   "choice_input": null
  },
  {
   "step": 8,
   "id": "tap_confirm_check_in",
   "intent": "Tap Confirm check-in to complete check-in",
   "target_fixed_text": "Confirm check-in",
   "choice_input": null
  }
 ],
 "outputs": [
  {
   "name": "seat",
