 "cross_post_tool": {
  "description": "Post to several apps in one request: one task with a part per destination, each part running a routine the user\nshares with agents (instagram_reel_song, tiktok_post_sound, youtube_short_sound, say) with that routine's own inputs.\nThe parts run one after another, and each post waits for the user's OK in Envoy on their phone: nothing is posted\nwithout it. Returns the task_id at once; follow it with get_task, whose `posts` gives each destination's outcome:\ndone, failed or declined (not posted), waiting, verifying… or outcome unknown. Outcome unknown means the post tap\nwent through and the run ended before its check: tell the user to check that app; Envoy never posts there again by\nitself. To finish the rest, call cross_post with retry set to the task_id: only destinations that failed or were\ndeclined run again.",
  "inputSchema": {
   "properties": {
    "posts": {
     "anyOf": [
      {
       "items": {
        "$ref": "#/$defs/PostArgs"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "One per app: the routine to post with and its inputs. Leave out with retry.",
     "title": "Posts"
    },
    "retry": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "A cross-post's task_id: run again only its destinations that failed or were declined.",
     "title": "Retry"
    },
    "phone": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Which phone runs it: an id from list_phones, \"phone\" (the user's own Android phone; Envoy asks them in Envoy first) or \"emulator\". Leave it out and Envoy picks the phone as it always does.",
     "title": "Phone"
    }
   },
   "type": "object",
   "$defs": {
    "PostArgs": {
     "description": "One destination of a cross-post.",
     "properties": {
      "routine": {
       "description": "A routine the user shares with agents, by its name or its tool's name, e.g. instagram_reel_song",
       "title": "Routine",
       "type": "string"
      },
      "inputs": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "That routine's inputs, exactly as its own tool takes them",
       "title": "Inputs",
       "type": "object"
      }
     },
     "required": [
      "routine"
     ],
     "title": "PostArgs",
     "type": "object"
    }
   },
   "title": "cross_postArguments"
  }
 },
