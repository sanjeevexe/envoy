{
 "name": "skylark_check_in_flight",
 "intent": "Check in for a SkyLark flight",
 "description": "Opens My Trips in SkyLark Air, selects the trip matching the requested destination, completes the passenger, hazardous-materials and review steps, confirms check-in, and then reopens the trip to verify the checked-in status and return the seat, gate and boarding details.",
 "patterns": [
  "Check me in for my flight",
  "Check in for my upcoming flight",
  "Please check me in",
  "Check in for my trip"
 ],
 "inputs": [
  {
   "name": "trip_city",
   "type": "text",
   "description": "Destination city of the flight to check in for.",
   "from_memory": null,
   "example": "Denver"
  }
 ],
 "steps": [
  {
   "step": 1,
   "id": "open_my_trips",
   "intent": "Tap My Trips to find the flight to check in for",
   "target_fixed_text": "My Trips",
   "choice_input": null
  },
  {
   "step": 2,
   "id": "open_trip_to_destination",
   "intent": "Open the trip to {{trip_city}}",
   "target_fixed_text": null,
   "choice_input": "trip_city"
  },
  {
   "step": 3,
   "id": "start_check_in",
   "intent": "Tap Check in to start check-in",
   "target_fixed_text": "Check in",
   "choice_input": null
  },
  {
   "step": 4,
   "id": "select_passenger",
   "intent": "Select the passenger to check in",
   "target_fixed_text": null,
   "choice_input": null
  },
  {
   "step": 5,
   "id": "continue_after_passenger",
   "intent": "Tap Continue after selecting the passenger",
   "target_fixed_text": "Continue",
   "choice_input": null
  },
  {
   "step": 6,
   "id": "confirm_no_hazardous_materials",
   "intent": "Confirm that you are not carrying hazardous materials",
   "target_fixed_text": "I'm not carrying hazardous materials",
   "choice_input": null
  },
  {
   "step": 7,
   "id": "continue_after_hazardous_materials",
   "intent": "Tap Continue after the hazardous-materials confirmation",
   "target_fixed_text": "Continue",
   "choice_input": null
  },
  {
   "step": 8,
   "id": "confirm_trip_review",
   "intent": "Tap Looks good to confirm the trip review",
   "target_fixed_text": "Looks good",
   "choice_input": null
  },
  {
   "step": 9,
   "id": "confirm_check_in",
   "intent": "Tap Confirm check-in to finish checking in",
   "target_fixed_text": "Confirm check-in",
   "choice_input": null
  },
  {
   "step": 10,
   "id": "dismiss_boarding_pass",
   "intent": "Tap Done to dismiss the boarding pass",
   "target_fixed_text": "Done",
   "choice_input": null
  },
  {
   "step": 11,
   "id": "reopen_my_trips",
   "intent": "Tap My Trips to verify check-in is complete",
   "target_fixed_text": "My Trips",
   "choice_input": null
  },
  {
   "step": 12,
   "id": "reopen_trip_to_destination",
   "intent": "Open the trip to {{trip_city}} again to confirm it is checked in",
   "target_fixed_text": null,
   "choice_input": "trip_city"
  }
 ],
 "outputs": [
  {
   "name": "check_in_status",
   "near": "You're checked in",
   "example": "You're checked in"
  },
  {
   "name": "seat",
   "near": "Seat",
   "example": "22F"
  },
  {
   "name": "gate",
   "near": "Gate",
   "example": "A7"
  },
  {
   "name": "boarding_time",
   "near": "Boarding",
   "example": "2:05 PM"
  },
  {
   "name": "boarding_group",
   "near": "Boarding",
   "example": "Group 5"
  }
 ],
