# Copy to .env and fill in. .env is gitignored; never commit real values.

# Meta Model API (OpenAI-compatible). Needed for chat and demo_setup.py's memory step; the tests and saved routines by name run without it.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Contributor tier: Meta may train on what is sent. Allowed ONLY for our own test apps.
META_CONTRIBUTOR_TIER=false
# Daily spending cap for the cost meter, in US dollars
META_DAILY_COST_CAP_USD=10

# Android SDK (also exported in ~/.zshrc)
ANDROID_HOME=~/Library/Android/sdk

# Emulators: AVD names and their gRPC ports
ENVOY_TEST_AVD=envoy-test
ENVOY_TEST_GRPC_PORT=8554
ENVOY_REAL_AVD=envoy-real
ENVOY_REAL_GRPC_PORT=8556

# Required: the API won't start without it. It's the token agents such as Muse use to call /mcp.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=
MCP_PORT=8765
REST_PORT=8766
